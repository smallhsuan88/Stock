/** =========================================================
 * market_tw_update.gs  (Stable + Date-safe + 3-layer fallback)
 * Daily update: fetch today (or given date), append Raw, compute Signals
 *
 * Layers:
 *   1) TWSE RWD afterTrading/MT_INDX (date-specific)  -> may 404 sometimes
 *   2) TWSE legacy exchangeReport/MI_INDEX (date-specific)
 *   3) TWSE OpenAPI exchangeReport/MI_INDEX (latest) + ROC date support
 *
 * Fixes:
 * 1) Normalize raw date values (Date object / string / ROC yyyMMdd) -> yyyy-MM-dd
 * 2) Sort raw rows by date asc so "latest" always correct
 * 3) Prevent duplicate append when existing dates are Date objects / ROC strings
 * 4) If fetch failed => DO NOT clear Signals (keeps last valid row)
 * ========================================================= */

var MarketTWUpdate = (function () {
  const RAW_SHEET = 'Raw_Market_TW';
  const SIG_SHEET = 'Signals_Market_TW';
  const MARKET_CODE = 'TW';
  const MA60_N = 60;

  function runMarketTW() {
    const ss = SpreadsheetApp.getActive();
    const raw = ss.getSheetByName(RAW_SHEET);
    const sig = ss.getSheetByName(SIG_SHEET);
    if (!raw || !sig) throw new Error('Raw_Market_TW or Signals_Market_TW not found');

    ensureRawHeader_(raw);

    // 今天（台北時區）
    const todayYmd = Utilities.formatDate(new Date(), 'Asia/Taipei', 'yyyyMMdd');

    // ✅ 三層抓資料
    const parsed = fetchOneDay_(todayYmd);

    // 若今天非交易日/尚未出完資料，parsed 會是 null：略過，不清空 Signals
    if (parsed) {
      appendIfNotExists_(raw, parsed);
    } else {
      Logger.log(`[runMarketTW] No new data for want=${todayYmd}. Keep Signals as-is.`);
      return;
    }

    const all = readRaw_(raw); // normalized + sorted + dedup
    if (all.length < MA60_N + 1) {
      Logger.log(`Not enough trading days in Raw: ${all.length}`);
      return;
    }

    const latest = calcSignal_(all);

    // 寫 Signals（只留一筆）
    sig.clearContents();
    sig.appendRow(['market','date','taiex_close','market_value','market_volume','ma60','ma60_state','ma60_streak_days']);
    sig.appendRow([
      MARKET_CODE,
      latest.date,
      latest.close,
      latest.market_value,
      latest.market_volume,
      latest.ma60,
      latest.ma60_state,
      latest.ma60_streak_days
    ]);
  }

  // =======================
  // Fetch (3-layer)
  // =======================
  function fetchOneDay_(yyyymmdd) {
    // Layer 1) RWD (date-specific)
    const rwd = fetchFromRwd_(yyyymmdd);
    if (rwd) return rwd;

    // Layer 2) legacy exchangeReport (date-specific)
    const legacy = fetchFromLegacy_(yyyymmdd);
    if (legacy) return legacy;

    // Layer 3) OpenAPI (latest) — only accept if date >= want
    const oa = fetchFromOpenApi_(yyyymmdd);
    if (oa) return oa;

    return null;
  }

  function fetchFromRwd_(yyyymmdd) {
    const url = `https://www.twse.com.tw/rwd/zh/afterTrading/MT_INDX?response=json&date=${yyyymmdd}&type=ALL`;
    const resp = UrlFetchApp.fetch(url, {
      muteHttpExceptions: true,
      headers: { 'User-Agent': 'Mozilla/5.0' }
    });

    Logger.log(`[MT_INDX:RWD] want=${yyyymmdd} code=${resp.getResponseCode()}`);
    const txt = resp.getContentText();
    Logger.log(`[MT_INDX:RWD] body_head=${txt ? txt.slice(0, 120) : '(empty)'}`);

    if (resp.getResponseCode() !== 200) return null;
    if (!txt) return null;

    let json;
    try { json = JSON.parse(txt); } catch (e) {
      Logger.log(`[MT_INDX:RWD] JSON parse error: ${e}`);
      return null;
    }

    const parsed = parseTaiExFromTables_(json, yyyymmdd);
    if (!parsed) return null;

    // RWD 是 date-specific；若解析成功就直接用
    return parsed;
  }

  function fetchFromLegacy_(yyyymmdd) {
    // 注意：這支常比 rwd 穩（date-specific）
    const url = `https://www.twse.com.tw/exchangeReport/MI_INDEX?response=json&date=${yyyymmdd}&type=ALL`;
    const resp = UrlFetchApp.fetch(url, {
      muteHttpExceptions: true,
      headers: { 'User-Agent': 'Mozilla/5.0' }
    });

    Logger.log(`[MI_INDEX:LEGACY] want=${yyyymmdd} code=${resp.getResponseCode()}`);
    const txt = resp.getContentText();
    Logger.log(`[MI_INDEX:LEGACY] body_head=${txt ? txt.slice(0, 120) : '(empty)'}`);

    if (resp.getResponseCode() !== 200) return null;
    if (!txt) return null;

    let json;
    try { json = JSON.parse(txt); } catch (e) {
      Logger.log(`[MI_INDEX:LEGACY] JSON parse error: ${e}`);
      return null;
    }

    // legacy 結構跟 rwd 很像，也有 tables
    const parsed = parseTaiExFromTables_(json, yyyymmdd);
    if (!parsed) return null;

    return parsed;
  }

  function fetchFromOpenApi_(yyyymmdd) {
    const url = `https://openapi.twse.com.tw/v1/exchangeReport/MI_INDEX`;
    const resp = UrlFetchApp.fetch(url, {
      muteHttpExceptions: true,
      headers: { 'User-Agent': 'Mozilla/5.0' }
    });

    Logger.log(`[MI_INDEX:OPENAPI] want=${yyyymmdd} code=${resp.getResponseCode()}`);
    const txt = resp.getContentText();
    Logger.log(`[MI_INDEX:OPENAPI] body_head=${txt ? txt.slice(0, 120) : '(empty)'}`);

    if (resp.getResponseCode() !== 200) return null;
    if (!txt) return null;

    let arr;
    try { arr = JSON.parse(txt); } catch (e) {
      Logger.log(`[MI_INDEX:OPENAPI] JSON parse error: ${e}`);
      return null;
    }

    const parsed = parseTaiExFromOpenApi_(arr);
    if (!parsed) return null;

    // ✅ OpenAPI 多半回「最新交易日」；只有當 latest >= want 才視為滿足（避免拿舊資料冒充今天）
    const wantIso = toIsoDate_(yyyymmdd);
    if (parsed.date && parsed.date < wantIso) {
      Logger.log(`[MI_INDEX:OPENAPI] latest(${parsed.date}) < want(${wantIso}) => not-ready`);
      return null;
    }

    return parsed;
  }

  // =======================
  // Parsers
  // =======================
  function parseTaiExFromTables_(json, yyyymmdd) {
    const tables = Array.isArray(json && json.tables) ? json.tables : null;
    if (!tables) return null;

    for (const t of tables) {
      const data = Array.isArray(t.data) ? t.data : [];
      for (const row of data) {
        const name = String(row[0] ?? '');
        if (name.includes('發行量加權股價指數')) {
          const close = parseNum_(row[1]);
          if (!isFinite(close) || close <= 0) return null;

          return {
            market: MARKET_CODE,
            date: toIsoDate_(yyyymmdd),   // yyyy-MM-dd
            close,
            market_value: '',             // 這支表通常沒有你要的 value/volume
            market_volume: ''
          };
        }
      }
    }
    return null;
  }

  function parseTaiExFromOpenApi_(arr) {
    if (!Array.isArray(arr)) return null;

    for (const it of arr) {
      // OpenAPI 欄位多為中文鍵：日期/指數/收盤指數/成交金額/成交股數...
      const name = String(it['指數'] ?? it.IndexName ?? it.Index ?? '').trim();
      if (!name.includes('發行量加權股價指數')) continue;

      const close = parseNum_(it['收盤指數'] ?? it.ClosingIndex ?? it.Close ?? '');
      if (!isFinite(close) || close <= 0) return null;

      // ✅ 日期可能是:
      // - "2026/01/05"
      // - "2026-01-05"
      // - 民國 7 碼 "1150102"
      const dateIso = normalizeDate_(it['日期'] ?? it.Date ?? it.date ?? '');
      if (!dateIso) return null;

      // 成交金額/成交股數（若沒有就留空）
      const mv = it['成交金額'] ?? it.TradeValue ?? '';
      const mvol = it['成交股數'] ?? it.TradeVolume ?? '';

      return {
        market: MARKET_CODE,
        date: dateIso,
        close,
        market_value: mv,
        market_volume: mvol
      };
    }

    return null;
  }

  // =======================
  // Raw sheet I/O
  // =======================
  function ensureRawHeader_(sh) {
    if (sh.getLastRow() === 0) sh.appendRow(['market','date','close','market_value','market_volume']);
  }

  function appendIfNotExists_(sh, obj) {
    const lastRow = sh.getLastRow();
    const exist = (lastRow >= 2)
      ? sh.getRange(2, 2, lastRow - 1, 1).getValues().flat().map(normalizeDate_)
      : [];
    const set = new Set(exist);

    const d = normalizeDate_(obj.date);
    if (!d) return;
    if (set.has(d)) {
      Logger.log(`[appendIfNotExists_] already has date=${d}, skip`);
      return;
    }

    sh.getRange(lastRow + 1, 1, 1, 5).setValues([[
      obj.market,
      d,
      obj.close,
      obj.market_value ?? '',
      obj.market_volume ?? ''
    ]]);
    Logger.log(`[appendIfNotExists_] appended date=${d} close=${obj.close}`);
  }

  function readRaw_(sh) {
    if (sh.getLastRow() < 2) return [];
    const v = sh.getRange(2, 1, sh.getLastRow() - 1, 5).getValues();

    const rows = v.map(r => ({
      market: r[0],
      date: normalizeDate_(r[1]),
      close: Number(r[2]),
      market_value: r[3],
      market_volume: r[4]
    })).filter(x => x.date && isFinite(x.close) && x.close > 0);

    // asc by date
    rows.sort((a, b) => a.date.localeCompare(b.date));

    // 去重：同一天只留最後一筆
    const dedup = [];
    const seen = new Set();
    for (let i = rows.length - 1; i >= 0; i--) {
      const d = rows[i].date;
      if (seen.has(d)) continue;
      seen.add(d);
      dedup.push(rows[i]);
    }
    dedup.reverse();

    return dedup;
  }

  // =======================
  // Signals
  // =======================
  function calcSignal_(rows) {
    const closes = rows.map(r => r.close);
    const last = rows[rows.length - 1];

    const ma60 = sma_(closes, MA60_N);
    if (!isFinite(ma60)) {
      return { ...last, ma60: NaN, ma60_state: '', ma60_streak_days: 0 };
    }

    const state = last.close >= ma60 ? 'ABOVE' : 'BELOW';

    let streak = 0;
    for (let i = rows.length - 1; i >= 0; i--) {
      const c = rows[i].close;
      const m = sma_(closes.slice(0, i + 1), MA60_N);
      if (!isFinite(m)) break;

      const isAbove = c >= m;
      if ((state === 'ABOVE' && isAbove) || (state === 'BELOW' && !isAbove)) streak++;
      else break;
    }

    return { ...last, ma60, ma60_state: state, ma60_streak_days: streak };
  }

  function sma_(arr, win) {
    if (!arr || arr.length < win) return NaN;
    let s = 0;
    for (let i = arr.length - win; i < arr.length; i++) s += Number(arr[i]) || 0;
    return s / win;
  }

  // =======================
  // Utils
  // =======================
  function toIsoDate_(yyyymmdd) {
    return `${yyyymmdd.slice(0,4)}-${yyyymmdd.slice(4,6)}-${yyyymmdd.slice(6,8)}`;
  }

  function parseNum_(s) {
    const n = Number(String(s ?? '').replace(/,/g, '').trim());
    return isFinite(n) ? n : NaN;
  }

  /**
   * Date 正規化：
   * - Date object
   * - yyyy-MM-dd
   * - yyyy/MM/dd
   * - yyyymmdd
   * - 民國 7 碼 yyyMMdd (e.g. 1150102) -> 2026-01-02
   * - 其他可 parse 字串
   */
  function normalizeDate_(val) {
    if (!val) return '';

    // Date object
    if (Object.prototype.toString.call(val) === '[object Date]' && !isNaN(val)) {
      return Utilities.formatDate(val, 'Asia/Taipei', 'yyyy-MM-dd');
    }

    const s = String(val).trim();
    if (!s) return '';

    // yyyy-MM-dd
    if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;

    // yyyy/MM/dd
    if (/^\d{4}\/\d{2}\/\d{2}$/.test(s)) return s.replace(/\//g, '-');

    // yyyymmdd
    if (/^\d{8}$/.test(s)) {
      return `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}`;
    }

    // ROC yyyMMdd (7 digits) e.g. 1150102 -> 2026-01-02
    if (/^\d{7}$/.test(s)) {
      const rocYear = Number(s.slice(0, 3));
      const adYear = rocYear + 1911;
      const mm = s.slice(3, 5);
      const dd = s.slice(5, 7);
      if (adYear >= 1912 && Number(mm) >= 1 && Number(mm) <= 12 && Number(dd) >= 1 && Number(dd) <= 31) {
        return `${adYear}-${mm}-${dd}`;
      }
    }

    // Try parse
    const d = new Date(s);
    if (!isNaN(d)) return Utilities.formatDate(d, 'Asia/Taipei', 'yyyy-MM-dd');

    return '';
  }

  return { runMarketTW };
})();

// ✅ Apps Script 可執行入口
function runMarketTW() {
  MarketTWUpdate.runMarketTW();
}
